{
  "name": "creai-smoke-tests",
  "version": "1.0.0",
  "description": "Smoke test de la homepage publica de https://creai.mx con Playwright + TypeScript",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:evidence": "EVIDENCE=1 playwright test",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium"
  },
  "keywords": [
    "playwright",
    "smoke-test",
    "qa",
    "automation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
